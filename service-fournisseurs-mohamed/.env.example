# =============================================================================
# ProcuraFlow — Service Fournisseurs (Mohamed)
# Environment Configuration Template
# =============================================================================

SERVER_PORT=8081

# -----------------------------------------------------------------------------
# OPTION 1: Local Docker PostgreSQL (container on localhost:5432)
# -----------------------------------------------------------------------------
# DATABASE_URL=jdbc:postgresql://localhost:5432/db_achats_univ?currentSchema=schema_fournisseurs
# DATABASE_USERNAME=admin_achats
# DATABASE_PASSWORD=pass_secure

# -----------------------------------------------------------------------------
# OPTION 2: Neon Cloud PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://<neon-endpoint-host>:5432/procura_flow?sslmode=require&currentSchema=schema_fournisseurs
DATABASE_USERNAME=<neon-username>
DATABASE_PASSWORD=<neon-password>

# Database schema owned by Fournisseurs service
DATABASE_SCHEMA=schema_fournisseurs

# Hibernate DDL strategy (Keep 'validate' for pre-seeded database)
JPA_DDL_AUTO=validate

# Downstream Microservice Integration
COMMANDES_SERVICE_URL=http://localhost:8082
COMMANDES_CONNECT_TIMEOUT_MS=3000
COMMANDES_READ_TIMEOUT_MS=5000
