    {
      "name": "4. Service Factures (Hamza - 8084)",
      "description": "API REST du Microservice Factures : validation de conformité, enregistrement sur Neon DB avec Drizzle ORM, gestion du cycle de vie et paiements.",
      "item": [
        {
          "name": "1. Santé du service - GET /api/health (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Service is UP\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"UP\");",
                  "    pm.expect(jsonData.service).to.eql(\"service-factures\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{FACTURES_BASE_URL}}/api/health",
              "host": [
                "{{FACTURES_BASE_URL}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "2. Créer une facture - POST /api/factures (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Facture créée avec succès\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.statut_paiement).to.eql(\"NON_PAYEE\");",
                  "    pm.expect(jsonData.data.numero_facture).to.be.a(\"string\");",
                  "});",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.environment.set(\"factureId\", jsonData.data.id);",
                  "    console.log(\"Variable factureId mise à jour avec :\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
