              "mode": "raw",
              "raw": "{\n  \"commande_id\": {{commandeId}},\n  \"reception_id\": {{receptionId}},\n  \"montant_facture\": 1500.00,\n  \"date_facture\": \"2026-11-12\"\n}"
            },
