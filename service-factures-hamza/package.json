{
  "name": "service-factures",
  "version": "1.0.0",
  "description": "Microservice Factures - ProcuraFlow : Système Distribué de Gestion des Achats et Fournisseurs (TypeScript)",
  "main": "dist/server.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "jest --verbose --forceExit --detectOpenHandles",
    "test:recette": "jest tests/recette.test.ts --verbose",
    "test:unit": "jest --verbose --testPathPattern=tests/unit",
    "test:integration": "jest --verbose --testPathPattern=tests/integration --forceExit --detectOpenHandles",
    "test:coverage": "jest --verbose --coverage --forceExit --detectOpenHandles"
  },
  "keywords": [
    "microservice",
    "factures",
    "procuraflow",
    "express",
    "postgresql",
    "typescript"
  ],
  "author": "Hamza AIT BENAYAD",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
